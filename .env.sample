# ─────────────────────────────────────────────
#  Pi Agent — Provider API Keys Sample
#  Copy to .env and fill in your keys
#  Auto-loaded from multi-agents/.env by multi-team.ts and mcp-bridge.ts
#  Optional override: PI_ENV_FILE=relative/path/to/.env
# ─────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=AIza...

# OpenRouter
OPENROUTER_API_KEY=sk-or-...

# MiniMax
MINIMAX_API_KEY=...

# Z.ai
ZAI_API_KEY=...

# Firecrawl (used by pi-pi expert agents for web crawling)
FIRECRAWL_API_KEY=fc-...

# Context Memory / Vector Retrieval
# 0 = disabled, 1 = enabled
MAH_CONTEXT_MEMORY=1
MAH_VECTOR_RETRIEVAL=0
MAH_QMD_PATH=qmd

# Vector proxy (pvector-compatible)
MAH_PVECTOR_URL=http://localhost:8080
MAH_PVECTOR_COLLECTION=mah-context

# Native pgvector proxy backend (optional)
MAH_PGVECTOR_DSN=postgresql://mah:mah@localhost:5432/mah_context
MAH_PGVECTOR_TABLE=context_vectors
MAH_PGVECTOR_COLLECTION_MODE=none

# WebUI login (optional; defaults are admin / mah)
MAH_WEBUI_USER=admin
MAH_WEBUI_PASSWORD=mah
